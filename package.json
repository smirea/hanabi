{
	"name": "hanabi",
	"private": true,
	"type": "module",
	"scripts": {
		"routes:gen": "cd client && bunx tsr generate",
		"routes:watch": "cd client && bunx tsr watch",
		"server:dev": "API_PORT=${API_PORT:-3001} bun --watch server/src/index.ts",
		"client:dev": "CLIENT_PORT=${CLIENT_PORT:-3000} VITE_API_URL=${VITE_API_URL:-http://localhost:3001} bun --filter client dev",
		"dev": "bun run routes:gen && concurrently --restart-tries=-1 --restart-after=1000 --names 'server,client' --prefix-colors 'green,cyan' 'bun run server:dev' 'bun run client:dev'",
		"build": "bun run routes:gen && bun --filter client build",
		"preview": "bun run build && SERVE_CLIENT=1 API_PORT=${PORT:-3000} bun server/src/index.ts",
		"lint": "./scripts/lint.sh",
		"lint:ci": "oxlint -c oxlint.json --type-aware . && oxfmt --check --ignore-path .oxfmtignore .",
		"typecheck": "bun check",
		"test": "bun test"
	},
	"dependencies": {
		"@phosphor-icons/react": "^2.1.10",
		"@tanstack/react-router": "^1.159.5",
		"@vitejs/plugin-react": "^6.0.1",
		"concurrently": "^9.2.1",
		"drizzle-orm": "^0.45.1",
		"html2canvas": "^1.4.1",
		"motion": "^12.34.0",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"vite": "^8.0.10"
	},
	"devDependencies": {
		"@tanstack/router-cli": "^1.159.4",
		"@types/bun": "^1.4.4",
		"@types/react": "^19.2.13",
		"@types/react-dom": "^19.2.3",
		"oxfmt": "^0.79.0",
		"oxlint": "^1.94.0",
		"oxlint-tsgolint": "^7.0.2007"
	}
}
